# Runtime
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ENABLE_IN_PROCESS_SCHEDULER=true
SYNC_INTERVAL_HOURS=6
CRON_SECRET=replace-with-a-long-random-secret
ICE800_DB_PATH=./ice800.db

# Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=ice-800
JWT_AUDIENCE=ice-800-app
JWT_TTL_MINUTES=60
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-a-fernet-key

# Plaid
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=http://localhost:8000/api/plaid/webhook
# Required for production OAuth institutions when applicable
PLAID_REDIRECT_URI=

# Email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Credit report provider boundary
# disabled | mock | partner_http
CREDIT_PROVIDER=disabled
CREDIT_PROVIDER_ENDPOINT=
CREDIT_PROVIDER_CLIENT_ID=
CREDIT_PROVIDER_SECRET=
CREDIT_CONSENT_VERSION=v1
PRIVACY_VERSION=v1
TERMS_VERSION=v1

# Closed Beta
BETA_INVITE_REQUIRED=false
# Comma-separated access codes. Replace before sharing the beta.
BETA_INVITE_CODES=ICE800-BETA
BETA_COHORT=founder-beta
BETA_INVITE_SINGLE_USE=true

# Android / language
ANDROID_PACKAGE_NAME=com.ice800.app
DEFAULT_LANGUAGE=es

# Method Financial - liabilities / bill pay / balance transfer
METHOD_ENV=dev
METHOD_API_KEY=
METHOD_BASE_URL=https://dev.methodfi.com
METHOD_VERSION=2026-03-30
METHOD_OPAL_LAUNCH_URL=
METHOD_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false

# Engine by MoneyLion - card marketplace / prequalification / application handoff
ENGINE_API_TOKEN=
ENGINE_BASE_URL=https://api.engine.tech
ENGINE_PARTNER_PAGE_URL=
ENGINE_ENABLED=false
APPLICATIONS_ENABLED=false
